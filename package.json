{
  "name": "dsh-vdesktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "inject": ["computerUse", "tools"]
  },
  "scripts": {
    "build": "node scripts/build-ts.mjs",
    "dev-link": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-link.ps1"
  },
  "dependencies": {
    "esbuild": "^0.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.3",
    "@types/node": "^22.5.0"
  }
}
